<settings_variants>
	<settings name="st" description="Стандартные параметры">
		<timezone>Asia/Dubai</timezone>
		<locales>
			<locale>en_US.UTF-8 UTF-8</locale>
			<locale>ru_RU.UTF-8 UTF-8</locale>
			<default>en_US.UTF-8</default>
			<vconsole_add>FONT=cyr-sun16</vconsole_add>
			<vconsole_add>KEYMAP=us</vconsole_add>
			<vconsole_add>KEYMAP=ruwin_alt_sh-UTF-8</vconsole_add>
		</locales>
		<extra_ntfs_options>
		    <type>ntfs3</type>
			<!-- ntfs3 присутствует в ядре начиная с версии 5.15 (2021)
			может не загрузить систему, если в ntfs ошибки,
			исправляемые утилитой chkdsk (или её аналогами на линукс)
			на этот случай предусмотрен список шаблонов nofail_templates_list
			ntfs-3g более старый инструмент, требует одноименный пакет -->
			<locale>en_US.UTF-8</locale>
			<mask>umask=0022</mask>
		</extra_ntfs_options>
		<nofail_templates_list>ntfs3 ntfs-3g /extra /run /mnt /media</nofail_templates_list>
	</settings>
	
	<settings name="cyr" description="Кириллица по умолчанию">
		<timezone>Asia/Dubai</timezone>
		<locales>
			<locale>en_US.UTF-8 UTF-8</locale>
			<locale>ru_RU.UTF-8 UTF-8</locale>
			<default>ru_RU.UTF-8</default>
			<vconsole_add>FONT=cyr-sun16</vconsole_add>
			<vconsole_add>KEYMAP=us</vconsole_add>
			<vconsole_add>KEYMAP=ruwin_alt_sh-UTF-8</vconsole_add>
		</locales>
		<extra_ntfs_options>
		    <type>ntfs3</type>
			<locale>ru_RU.UTF-8</locale>
			<mask>umask=0022</mask>
		</extra_ntfs_options>
		<nofail_templates_list>ntfs3 ntfs-3g /extra /run /mnt /media</nofail_templates_list>
	</settings>
</settings_variants>
