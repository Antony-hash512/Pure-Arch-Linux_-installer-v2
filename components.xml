<install_locations>
	<install_location name="vivo_new_home_fld" description="Стандартоная установка ">
		<mountpoints>
			<point type="new">
				<location>/</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<names>@hypr_in_/dev/vivo/btrbox</names>
			</point>
			<point type="new">
				<location>/home</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<names>@home2_in_/dev/vivo/btrbox</names>
			</point>
		</mountpoints>
		
		<hostname>katana</hostname>
		<username>user</username>
		<useruid>1000</useruid>
		<hooks>base udev autodetect microcode modconf kms keyboard keymap consolefont block lvm2 resume filesystems fsck</hooks>
		<efi>
			<bootlabel>Hyprland_nocrypt2</bootlabel>
			<dev>/dev/nvme0n1p1</dev>
			<new_location>/boot/efi</new_location>
		</efi>
		<iso>false</iso>
	</install_location>
	
