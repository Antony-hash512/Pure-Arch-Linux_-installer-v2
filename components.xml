<install_locations>
	
	<install_location name="vivo_gnome" description="Установка GNOME на Vivobook">
		<mountpoints>
			<point type="new">
				<location>/</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<lv-volume>/dev/vivo/btrbox</lv-volume>
				<subvolume>@arch_gnome</subvolume>
			</point>
			<point type="new">
				<location>/home</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<lv-volume>/dev/vivo/btrbox</lv-volume>
				<subvolume>@home_gnome</subvolume>
			</point>
		</mountpoints>
		<hostname>vivobook</hostname>
		<username>fireice</username>
		<useruid>1000</useruid>
		<hooks>base udev autodetect microcode modconf kms keyboard keymap consolefont block lvm2 resume filesystems fsck</hooks>
		<legacy_bios>false</legacy_bios>
		<efi>
			<bootlabel>ArchGnomeNotCrypted</bootlabel>
			<dev>/dev/nvme0n1p1</dev>
			<new_location>/efi</new_location>
		</efi>
		<iso>false</iso>
	</install_location>
	
