base base-devel linux linux-firmware
#софт, который будет установлен на новую систему (тоже сразу, но уже pacman'ом)
		<bundle>networkmanager btrfs-progs nano vim mc man-db less links wget git htop p7zip unrar lvm2 cryptsetup cfdisk timeshift</bundle>
#дополнительные списки пакетов, которые можно включать и выключать ниже
		<bundle>curl ntfs-3g enca dosfstools openvpn os-prober docker tmux diff ncdu ffmpeg mediainfo</bundle>
		<bundle>neofetch cowsay</bundle>
		<bundle>alsa-utils pipewire pipewire-pulseaudio sof-firmware mplayer</bundle>
		<bundle>bluez bluez-utils blueman</bundle>
		<bundle>openbox gparted xorg-xinit tint2 volumeicon pnmixer volwheel nm-connection-editor network-manager-applet obconf alacritty terminator thunar udisks2 gvfs xed gmrun pavucontrol brightnessctl i3lock gsimplecal</bundle>
# TODO: проверить нужны ли мне: wmctrl xdotool(авто-действия); gsimplecal - мини-календарь
		<bundle>wmctrl xdotool</bundle>
		<bundle>meld geany gtksourceview5</bundle>
		<bundle>vimdiff, emacs, diff3</bundle>
		<bundle>firefox chromium vlc viewnior xfce4-screenshooter engrampa</bundle>
		<bundle>midori feh scrot xarchiver xterm</bundle>
		<bundle>tumbler menumaker conky pinta</bundle>
		<bundle>maim menyoki</bundle>
		<bundle>deluge deluge-gtk gimp inkscape krita obsidian</bundle>
		<bundle>qemu-system-x86 virtmanager</bundle>
		<bundle>i2pd tor electrum bitcoin-daemon bitcoin-qt monero p2pool xmrig</bundle>
		<bundle>libreoffice blender doublecmd godot shotcut openshot pitivi obs audacity</bundle>
		<bundle>stacer ananicy</bundle>

		<hooks>base udev autodetect microcode modconf kms keyboard keymap consolefont block lvm2 encrypt resume filesystems fsck</hooks>
		<extrafiles>
			<homefiles>
				<archive>homefiles.tar.gz</archive>
				<archive>homefiles_openbox.tar.gz</archive>
			</homefiles>
		</extrafiles>
-->
<systems>
	<system id="openbox_barehard_test43">
		<pakages>
			<pacstrap>base base-devel linux linux-firmware</pacstrap>
			<bundle>networkmanager btrfs-progs nano vim mc man-db less links wget git htop p7zip unrar lvm2 cryptsetup cfdisk timeshift</bundle>
			<bundle>neofetch cowsay</bundle>
			<bundle>curl ntfs-3g enca dosfstools openvpn os-prober docker tmux diff ncdu ffmpeg mediainfo</bundle>
			<bundle>alsa-utils pipewire pipewire-pulseaudio sof-firmware mplayer</bundle>
			<bundle>bluez bluez-utils blueman</bundle>
			<bundle>openbox gparted xorg-xinit tint2 volumeicon pnmixer volwheel nm-connection-editor network-manager-applet obconf alacritty terminator thunar udisks2 gvfs xed gmrun pavucontrol brightnessctl i3lock gsimplecal</bundle>
			<bundle>meld geany gtksourceview5</bundle>
			<bundle>firefox chromium vlc viewnior xfce4-screenshooter engrampa</bundle>
			<bundle>tumbler menumaker conky pinta</bundle>
		</pakages>
		<hooks>base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck</hooks>
		<extrafiles>
			<home>
				<archive>homefiles.tar.gz</archive>
				<archive>homefiles_openbox.tar.gz</archive>
			</home>
		</extrafiles>

		<mountpoints>
			<point type="new">
				<location>/</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<names>@arch_system_test43_in_/dev/mainvg/gigabox_in_/dev/nvme0n1p8</names>
			</point>
			<point type="new">
				<location>/home</location>
				<way>new_subvol_in_btrfs_in_lvm</way>
				<crypt_mode>none_in_none</crypt_mode>
				<names>@arch_home43_in_/dev/mainvg/gigabox_in_/dev/nvme0n1p8</names>
			</point>
		</mountpoints>


		<settings>
			<timezone>Asia/Dubai</timezone>
			<hostname>katana</hostname>
			<username>user</username>
			<useruid>1000</useruid>
			<locales>
				<locale>en_US.UTF-8 UTF-8</locale>
				<locale>ru_RU.UTF-8 UTF-8</locale>
				<default>en_US.UTF-8 UTF-8</default>
			</locales>
			<efi>
				<bootlabel>ArchTest43</bootlabel>
				<dev>/dev/nvme0n1p1</dev>
				<new_location>/boot/efi</new_location>
			</efi>
			<tweaks>
				<iso>false</iso>
				<openbox>true</openbox>
			</tweaks>
		</settings>
	</system>
</systems>
